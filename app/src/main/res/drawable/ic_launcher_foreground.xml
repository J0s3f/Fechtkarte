<?xml version="1.0" encoding="utf-8"?>
<!-- T7.1: the card's own checkerboard-and-eight-ray-star motif, in the default right-hand
     palette (Woad) — the same visual language CardRenderer already draws, not a new invention.
     No numeral: illegible at launcher-icon scale, and unnecessary — the geometry alone reads as
     "this app" once a card has been seen. Coordinates 27..81 (a 54x54 square centred in the
     108x108 canvas) sit well inside the adaptive-icon safe zone, so no OEM mask shape (circle,
     squircle, rounded square) clips the motif. See DESIGN_CHOICES.md. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- Woad light quadrants: top-left, bottom-right (matches CardRenderer's own checkerboard
         assignment). -->
    <path android:fillColor="#D3E9F9" android:pathData="M27,27h27v27h-27z"/>
    <path android:fillColor="#D3E9F9" android:pathData="M54,54h27v27h-27z"/>
    <!-- Woad dark quadrants: top-right, bottom-left. -->
    <path android:fillColor="#58ABE7" android:pathData="M54,27h27v27h-27z"/>
    <path android:fillColor="#58ABE7" android:pathData="M27,54h27v27h-27z"/>
    <!-- Card outline. -->
    <path android:strokeColor="#1A1A1A" android:strokeWidth="1.6" android:pathData="M27,27h54v54h-54z"/>
    <!-- The eight rays, centre to each edge midpoint and each corner. -->
    <path android:strokeColor="#1A1A1A" android:strokeWidth="1.2" android:pathData="M54,54L54,27"/>
    <path android:strokeColor="#1A1A1A" android:strokeWidth="1.2" android:pathData="M54,54L54,81"/>
    <path android:strokeColor="#1A1A1A" android:strokeWidth="1.2" android:pathData="M54,54L81,54"/>
    <path android:strokeColor="#1A1A1A" android:strokeWidth="1.2" android:pathData="M54,54L27,54"/>
    <path android:strokeColor="#1A1A1A" android:strokeWidth="1.2" android:pathData="M54,54L81,27"/>
    <path android:strokeColor="#1A1A1A" android:strokeWidth="1.2" android:pathData="M54,54L81,81"/>
    <path android:strokeColor="#1A1A1A" android:strokeWidth="1.2" android:pathData="M54,54L27,81"/>
    <path android:strokeColor="#1A1A1A" android:strokeWidth="1.2" android:pathData="M54,54L27,27"/>
</vector>
