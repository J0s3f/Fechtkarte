    <!-- Card description for screen readers (TalkBack). Assembled at runtime, so the spoken
         sentence reads: "Rechte Hand, drei Aktionen: eins, oben links außen; zwei, Stich,
         rechts außen; drei, unten außen." -->
    <string name="a11y_sequence_separator">"; "</string>
    <string name="a11y_card_description">%1$s, %2$s: %3$s.</string>
    <string name="a11y_hand_right">Rechte Hand</string>
    <string name="a11y_hand_left">Linke Hand</string>
    <string name="a11y_hand_neutral">Technikkarte</string>
    <!-- The singular drops the spoken number: the numeral word is "eins", but German needs the
         article form "eine" in front of a noun, and the same word resource has to stay "eins"
         where it is spoken alone as a sequence number. "eine Aktion" carries the count anyway. -->
    <plurals name="a11y_action_count" tools:ignore="StringFormatCount,ImpliedQuantity">
        <item quantity="one">eine Aktion</item>
        <item quantity="other">%1$s Aktionen</item>
    </plurals>
    <!-- %1$s is the spoken sequence number, %2$s the position. The thrust marker is set off by
         commas rather than joined with a preposition, because no single preposition governs
         both an adverbial position ("oben links außen") and the noun "Mitte". -->
    <string name="a11y_action_cut">%1$s, %2$s</string>
    <string name="a11y_action_thrust">%1$s, Stich, %2$s</string>
    <!-- %1$s is the direction, %2$s the ring: "oben links" + "außen". -->
    <string name="a11y_position_on_ring">%1$s %2$s</string>
    <string name="a11y_position_centre">Mitte</string>
    <string name="a11y_ring_inner">innen</string>
    <string name="a11y_ring_outer">außen</string>
    <string name="a11y_direction_n">oben</string>
    <string name="a11y_direction_ne">oben rechts</string>
    <string name="a11y_direction_e">rechts</string>
    <string name="a11y_direction_se">unten rechts</string>
    <string name="a11y_direction_s">unten</string>
    <string name="a11y_direction_sw">unten links</string>
    <string name="a11y_direction_w">links</string>
    <string name="a11y_direction_nw">oben links</string>
    <!-- Spoken sequence numbers, indexed 0..8. -->
    <string-array name="a11y_spoken_numbers">
        <item>null</item>
        <item>eins</item>
        <item>zwei</item>
        <item>drei</item>
        <item>vier</item>
        <item>fünf</item>
        <item>sechs</item>
        <item>sieben</item>
        <item>acht</item>
    </string-array>
