<?xml version="1.0" encoding="utf-8"?>
<!-- T8.3: the Room database (fechtkarte.db, plus its -wal/-shm journal files) is excluded —
     it's entirely reproducible from the bundled original_cards.json plus generated drills, so
     there's nothing in it worth restoring. DataStore preferences (fechtkarte_preferences,
     under files/datastore/) are deliberately left included: hand/palette choices and enabled
     generation rules are small, contain nothing sensitive, and are a genuine (if minor)
     convenience to restore on a device transfer or reinstall. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="fechtkarte.db" />
        <exclude domain="database" path="fechtkarte.db-shm" />
        <exclude domain="database" path="fechtkarte.db-wal" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="fechtkarte.db" />
        <exclude domain="database" path="fechtkarte.db-shm" />
        <exclude domain="database" path="fechtkarte.db-wal" />
    </device-transfer>
</data-extraction-rules>
