    <!-- Card description for screen readers (TalkBack). The assembly templates are
         themselves translatable so word order can differ per language — a literal
         translation of the English fragments alone would produce wrong grammar. -->
    <string name="a11y_card_description">%1$s, %2$s: %3$s.</string>
    <!-- Quoted so the trailing space survives: Android trims leading/trailing whitespace in
         string resources unless the value is wrapped in double quotes. Without it TalkBack runs
         the actions together ("outer;two") instead of pausing between them. Translatable
         because punctuation spacing is itself locale-specific — French puts a space before a
         semicolon, English and German do not. -->
    <string name="a11y_sequence_separator">"; "</string>
    <string name="a11y_hand_right">Right hand</string>
    <string name="a11y_hand_left">Left hand</string>
    <string name="a11y_hand_neutral">Technique card</string>
    <plurals name="a11y_action_count">
        <item quantity="one">%1$s action</item>
        <item quantity="other">%1$s actions</item>
    </plurals>
    <!-- %1$s is the spoken sequence number, %2$s the position. -->
    <string name="a11y_action_cut">%1$s, %2$s</string>
    <string name="a11y_action_thrust">%1$s, thrust to %2$s</string>
    <!-- %1$s is the direction, %2$s the ring. -->
    <string name="a11y_position_on_ring">%1$s %2$s</string>
    <string name="a11y_position_centre">centre</string>
    <string name="a11y_ring_inner">inner</string>
    <string name="a11y_ring_outer">outer</string>
    <string name="a11y_direction_n">top</string>
    <string name="a11y_direction_ne">upper right</string>
    <string name="a11y_direction_e">right</string>
    <string name="a11y_direction_se">lower right</string>
    <string name="a11y_direction_s">bottom</string>
    <string name="a11y_direction_sw">lower left</string>
    <string name="a11y_direction_w">left</string>
    <string name="a11y_direction_nw">upper left</string>
    <!-- Spoken sequence numbers, indexed 0..8. Words rather than digits: "one, upper
         left outer" reads more naturally than "1, upper left outer". -->
    <string-array name="a11y_spoken_numbers">
        <item>zero</item>
        <item>one</item>
        <item>two</item>
        <item>three</item>
        <item>four</item>
        <item>five</item>
        <item>six</item>
        <item>seven</item>
        <item>eight</item>
    </string-array>
