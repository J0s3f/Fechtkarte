<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Theme.AppCompat descendant, not android:Theme.Material: AppCompatActivity requires one,
         and MainActivity is an AppCompatActivity so the per-app language API (T9.8) works below
         Android 13. DayNight so the platform light/dark setting still applies — the card's own
         dark palette (T7.4) is separate from this and unaffected. -->
    <style name="Theme.Fechtkarte" parent="Theme.AppCompat.DayNight.NoActionBar" />

    <!-- T7.1: splash screen (androidx.core:core-splashscreen, backward-compatible to API 21,
         unlike the platform SplashScreen API which is 31+ only). Same paper background and
         icon motif as the launcher icon — one consistent identity, not two. MainActivity calls
         installSplashScreen() before super.onCreate(); see its own comment. -->
    <style name="Theme.Fechtkarte.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#FAF7F0</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.Fechtkarte</item>
    </style>
</resources>
