    <!-- Card description for screen readers (TalkBack). Read aloud, the whole sentence runs:
         « Main droite, trois actions : un, en haut à gauche, anneau extérieur ; deux, estoc
         à droite, anneau extérieur ; trois, en bas, anneau extérieur. »
         The ring carries its own noun (« anneau », masculine) so the adjective agreement is
         fixed whatever the direction phrase says, and the direction comes first, as a locative
         phrase — French cannot stack « haut gauche extérieur » the way English stacks
         "upper left outer". -->
    <!-- French typography puts a space before a semicolon. Quoted so it survives trimming. -->
    <string name="a11y_sequence_separator">" ; "</string>
    <string name="a11y_card_description">%1$s, %2$s : %3$s.</string>
    <string name="a11y_hand_right">Main droite</string>
    <string name="a11y_hand_left">Main gauche</string>
    <string name="a11y_hand_neutral">Carte de technique</string>
    <plurals name="a11y_action_count">
        <item quantity="one">%1$s action</item>
        <item quantity="other">%1$s actions</item>
    </plurals>
    <!-- %1$s is the spoken sequence number, %2$s the position. -->
    <string name="a11y_action_cut">%1$s, %2$s</string>
    <string name="a11y_action_thrust">%1$s, estoc %2$s</string>
    <!-- %1$s is the direction, %2$s the ring. -->
    <string name="a11y_position_on_ring">%1$s, %2$s</string>
    <string name="a11y_position_centre">au centre</string>
    <string name="a11y_ring_inner">anneau intérieur</string>
    <string name="a11y_ring_outer">anneau extérieur</string>
    <string name="a11y_direction_n">en haut</string>
    <string name="a11y_direction_ne">en haut à droite</string>
    <string name="a11y_direction_e">à droite</string>
    <string name="a11y_direction_se">en bas à droite</string>
    <string name="a11y_direction_s">en bas</string>
    <string name="a11y_direction_sw">en bas à gauche</string>
    <string name="a11y_direction_w">à gauche</string>
    <string name="a11y_direction_nw">en haut à gauche</string>
