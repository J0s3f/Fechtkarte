<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- No storage permissions: PNG/PDF export (T6.1/T6.2) writes through MediaStore's
         scoped-storage API only — no permission needed on Android 10+ (API 29+), where scoped
         storage applies. Below that, MediaStore inserts genuinely need WRITE_EXTERNAL_STORAGE
         at runtime; rather than add a permission-request flow for API 24-28 specifically,
         export requires API 29+ and says so on older devices — see docs/PLAN.md §8 ("Scoped
         storage throughout; no WRITE_EXTERNAL_STORAGE") and
         adapter/export/MediaStoreCardExporter.kt. The two permissions removed here were
         scaffold leftovers that directly contradicted their own comment ("we use MediaStore,
         no permission needed") — neither was ever exercised. -->

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:localeConfig="@xml/locales_config"
        android:label="@string/app_name"
        
        android:supportsRtl="true"
        android:theme="@style/Theme.Fechtkarte"
        tools:targetApi="31">
        <activity
            android:name=".adapter.ui.MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Fechtkarte.Starting">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Share (T6.3) renders into the app's private cache, not MediaStore — sharing
             shouldn't silently also save a copy into the user's public gallery/downloads.
             FileProvider is what exposes that one private file to the receiving app for the
             duration of the share; see adapter/export/FileProviderCardShare.kt and
             res/xml/file_paths.xml for exactly what's exposed. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>