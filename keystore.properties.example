# Copy to keystore.properties (gitignored, never commit real credentials) and fill in real
# values once a release keystore exists. Generate one with:
#
#   keytool -genkeypair -v -keystore release.keystore -alias fechtkarte \
#     -keyalg RSA -keysize 2048 -validity 10000
#
# See T9.4 in docs/NEXT_STEPS.md.

storeFile=release.keystore
storePassword=
keyAlias=fechtkarte
keyPassword=
